{{- /*
  Site shell: docked sidebar + main column (Hearth design). Every page is wrapped in this.
  Port of src/layouts/Base.astro.

  Theme: `data-theme` on <html> (localStorage, toggle button / `t` key) or system preference.
  Palette: `data-palette` from the config. `data-base` is how web/js/base.js learns the deploy
  base — nothing inlines values into files that are served verbatim, so it travels through the
  DOM instead.

  The body is rendered separately and passed in as .Body, so every template in this set stays
  a balanced document rather than an open tag waiting for its partner.
*/ -}}
{{define "shell"}}<!doctype html>
<html lang="en" data-palette="{{.Cfg.Theme.Palette}}" data-base="{{.Router.Base}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{{.FullTitle}}</title>
    {{- if .Description}}
    <meta name="description" content="{{.Description}}" />
    {{- end}}
    <link rel="icon" type="image/png" href="{{withBase "/logo.png"}}" />
    <link rel="icon" href="{{withBase "/favicon.ico"}}" />
    <link rel="stylesheet" href="{{withBase "/css/global.css"}}" />
    <link rel="stylesheet" href="{{withBase "/css/repo.css"}}" />
    {{- range .ExtraStyles}}
    <link rel="stylesheet" href="{{.}}" />
    {{- end}}
    {{- /*
      Stays inline, unlike every other script on the site: it exists to run before first
      paint, and an external file would reintroduce the flash of the wrong theme it was
      written to prevent.
    */}}
    <script>
      (function () {
        try {
          var t = localStorage.getItem('frznforge-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {{template "icon-sprite" .}}
    <hf-command-palette></hf-command-palette>
    <div class="hf-shell">
      {{template "sidebar" .}}
      <main class="hf-main" id="main">
        {{.Body}}
        <footer class="hf-footer">
          <span>Generated by <a href="https://github.com/Descent098/frznforge">frznforge</a> · static, read-only.</span>
          {{- if .Data.Warnings}}
          <span class="hf-footer-warn" title="{{.WarningSummary}}">{{len .Data.Warnings}} ingest warning{{if ne (len .Data.Warnings) 1}}s{{end}}</span>
          {{- end}}
        </footer>
      </main>
    </div>

    <script type="module" src="{{withBase "/js/theme.js"}}"></script>
    <script type="module" src="{{withBase "/js/hf-command-palette.js"}}"></script>
    {{- range .ExtraScripts}}
    <script type="module" src="{{.}}"></script>
    {{- end}}
  </body>
</html>
{{end}}
