{{- /* Port of src/pages/404.astro. */ -}}
{{define "page-404"}}
  <div class="hf-container">
    <section class="hf-card hf-404">
      <div class="hf-404-code">404</div>
      <h1>Nothing at this address.</h1>
      <p>The page may have moved when the site was rebuilt, or the link was never right.</p>
      <div class="hf-404-actions">
        <a class="hf-btn hf-btn--primary" href="{{homeURL}}"><svg class="hf-i"><use href="#i-home" /></svg> Overview</a>
        <a class="hf-btn" href="{{reposURL}}"><svg class="hf-i"><use href="#i-repo" /></svg> All repositories</a>
      </div>
    </section>
  </div>
{{end}}
