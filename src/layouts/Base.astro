---
/**
 * Site shell: docked sidebar + main column (Hearth design). Every page uses this.
 * Theme: `data-theme` on <html> (localStorage, toggle button / `t` key) or system preference.
 * Palette: `data-palette` from frznforge.config.ts.
 */
import '../styles/global.css';
import '../styles/repo.css';
import IconSprite from '../components/IconSprite.astro';
import Sidebar from '../components/Sidebar.astro';
import CommandPalette from '../components/CommandPalette.svelte';
import { withBase } from '../lib/base';
import { getConfig, getData } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Which primary nav item is current. `'notes'` / `'orgs'` were added in schema v4. */
  active?: 'profile' | 'repos' | 'notes' | 'orgs' | null;
}
const { title, description, active = null } = Astro.props;
const cfg = await getConfig();
const data = await getData();
const fullTitle = title === cfg.site.title ? title : `${title} · ${cfg.site.title}`;
---
<!doctype html>
<html lang="en" data-palette={cfg.theme.palette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={withBase('/logo.png')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('frznforge-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <IconSprite />
    <CommandPalette client:load />
    <div class="hf-shell">
      <Sidebar
        active={active}
        repoCount={data.repos.length}
        noteCount={data.notes.length}
        orgCount={data.organizations.length}
      />
      <main class="hf-main" id="main">
        <slot />
        <footer class="hf-footer">
          <span>Generated by <a href="https://github.com/Descent098/frznforge">frznforge</a> · static, read-only.</span>
          {data.warnings.length > 0 && (
            <span class="hf-footer-warn" title={data.warnings.map((w) => `[${w.code}] ${w.message}`).join('\n')}>
              {data.warnings.length} ingest warning{data.warnings.length === 1 ? '' : 's'}
            </span>
          )}
        </footer>
      </main>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('hf-theme-toggle');
        if (!btn) return;
        function current() {
          var t = document.documentElement.getAttribute('data-theme');
          if (t) return t;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function toggle() {
          var next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('frznforge-theme', next); } catch (e) {}
        }
        btn.addEventListener('click', toggle);
        document.addEventListener('keydown', function (e) {
          if (e.key === 't' && !e.ctrlKey && !e.metaKey && !e.altKey && !/input|textarea|select/i.test(e.target.tagName)) toggle();
        });
      })();
    </script>
  </body>
</html>
