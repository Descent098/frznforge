---
/**
 * Hero band for one organization's overview page (schema v4).
 *
 * Deliberately mirrors the owner profile hero in `src/pages/index.astro` — same `hf-hero`
 * shell, same KPI grid columns (3 + 3 + 2 + 4 of 12) — so an org reads as "a profile for a
 * group of repos" rather than as a different kind of page. Everything it shows is derived
 * from the artifact plus the optional `<content.orgs>/<slug>.md` frontmatter, so an org with
 * no markdown file still renders a complete header.
 */
import type { Organization, Repo } from '../lib/data/schema';
import type { OrgFrontmatter } from '../content.config';
import {
  aggregateLanguages,
  commitsSince,
  earliestCommit,
  formatInt,
  getConfig,
  heatFor,
  initials,
  monthYear,
  prettyUrl,
  yearsSince,
} from '../lib/site';

interface Props {
  org: Organization;
  /** The org's member repos, already resolved from the artifact. May be empty. */
  repos: Repo[];
  /** Frontmatter of `<content.orgs>/<slug>.md`, or null when the file does not exist. */
  fm: OrgFrontmatter | null;
  /** Build-time reference clock, so every page of one build agrees on "now". */
  now: Date;
}
const { org, repos, fm, now } = Astro.props;

// Frontmatter wins over the config `description`: the markdown file is the thing an author
// edits most often, and it is the only one of the two that can be absent.
const description = fm?.description ?? org.description;

const repoCount = repos.length;
// Same "recent" window as the profile hero: `theme.heat.hot`, so KPI copy and the orange
// recency accent agree on what counts as recent.
const cfg = await getConfig();
const heatDays = cfg.theme.heat;
const hotWindow = heatDays.hot === 7 ? 'this week' : `in the last ${heatDays.hot} days`;
const commitsThisYear = commitsSince(repos, 365, now);
const commitsRecent = commitsSince(repos, heatDays.hot, now);
const firstCommit = earliestCommit(repos);
const years = yearsSince(firstCommit, now);
const languages = aggregateLanguages(repos, 5);
const templates = repos.filter((r) => r.template).length;
const touchedRecently = repos.filter((r) => heatFor(r.updatedAt, now, heatDays) === 'hot').length;

const links = Object.entries(fm?.links ?? {}) as Array<[string, string]>;
---
<section class="hf-hero" aria-labelledby="org-name">
  <div class="hf-avatar hf-avatar--xl" aria-hidden="true">{initials(org.name)}</div>
  <div class="hf-hero-id">
    <div class="hf-hero-name">
      <h1 id="org-name">{org.name}</h1>
      <span class="hf-handle">@{org.slug}</span>
    </div>
    {description && <p class="hf-hero-bio">{description}</p>}
    <ul class="hf-hero-meta">
      <li>
        <!--
          #i-layers, not #i-people: the sidebar and the command palette already mark
          organizations with it, and a frznforge organization is a stack of repositories —
          there are no accounts or members behind it for a people glyph to stand for.
        -->
        <svg class="hf-i"><use href="#i-layers" /></svg>
        Organization · {formatInt(repoCount)} member repositor{repoCount === 1 ? 'y' : 'ies'}
      </li>
    </ul>
    <div class="hf-hero-links">
      {(fm?.sites ?? []).map((url, i) => (
        <a class:list={['hf-pill', { 'hf-pill--accent': i === 0 }]} href={url}>
          <svg class="hf-i"><use href="#i-globe" /></svg> {prettyUrl(url)}
        </a>
      ))}
      {links.map(([label, url]) => (
        <a class="hf-pill" href={url}><svg class="hf-i"><use href="#i-link" /></svg> {label}</a>
      ))}
    </div>
  </div>

  <div class="hf-hero-kpis" aria-label={`${org.name} statistics`}>
    <div class="hf-kpi hf-kpi--ember">
      <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-repo" /></svg> Repositories</div>
      <div class="hf-kpi-value">{formatInt(repoCount)}</div>
      <div class="hf-kpi-sub">
        {touchedRecently > 0 ? <><span class="t-hot">{touchedRecently} touched</span> {hotWindow}</> : `none touched ${hotWindow}`}
        {templates > 0 && <> · {templates} template{templates === 1 ? '' : 's'}</>}
      </div>
    </div>
    <div class="hf-kpi hf-kpi--ember">
      <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-commit" /></svg> Commits this year</div>
      <div class="hf-kpi-value">{formatInt(commitsThisYear)}</div>
      <div class="hf-kpi-sub">{commitsRecent > 0 ? <><span class="t-hot">+{formatInt(commitsRecent)}</span> in the last {heatDays.hot} days</> : `none in the last ${heatDays.hot} days`}</div>
    </div>
    <div class="hf-kpi hf-kpi--ice">
      <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-history" /></svg> Years of history</div>
      <div class="hf-kpi-value">{years}</div>
      <div class="hf-kpi-sub">{firstCommit ? <>first commit <span class="t-cold">{monthYear(firstCommit)}</span></> : 'no commits yet'}</div>
    </div>
    <div class="hf-kpi hf-kpi-langs">
      <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-code" /></svg> Top languages</div>
      {languages.length ? (
        <>
          <div class="hf-langbar" aria-hidden="true">
            {languages.map((l) => <span style={`width:${l.percent}%;background:${l.color ?? 'var(--hf-lang-other)'}`}></span>)}
          </div>
          <div class="hf-lang-legend">
            <ul>
              {languages.map((l) => <li><i class="hf-lang-dot" style={`background:${l.color ?? 'var(--hf-lang-other)'}`}></i><b>{l.name}</b><i>{l.percent}%</i></li>)}
            </ul>
          </div>
        </>
      ) : (
        <div class="hf-kpi-sub">No code detected yet.</div>
      )}
    </div>
  </div>
</section>
