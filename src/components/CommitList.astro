---
/**
 * Paginated commit list for one branch, grouped by day (GitHub style). Shared by the
 * commits index and /page/N routes.
 */
import { COMMITS_PER_PAGE, commitUrl, commitsPageCount, commitsUrl } from '../lib/routes';
import { formatInt, heatFor, initials, relativeTime } from '../lib/site';
import type { Commit, Repo } from '../lib/data/schema';

interface Props {
  repo: Repo;
  refName: string;
  page: number;
}
const { repo, refName, page } = Astro.props;
const now = new Date();
const branch = repo.branches.find((b) => b.name === refName)!;
const pageCount = commitsPageCount(repo, refName);
const shas = branch.commits.slice((page - 1) * COMMITS_PER_PAGE, page * COMMITS_PER_PAGE);
const commits = shas.map((s) => repo.commits[s]).filter((c): c is Commit => !!c);

/** Group by UTC day, preserving order (newest first). */
const groups: Array<{ day: string; commits: Commit[] }> = [];
for (const c of commits) {
  const day = c.commitDate.slice(0, 10);
  const last = groups[groups.length - 1];
  if (last && last.day === day) last.commits.push(c);
  else groups.push({ day, commits: [c] });
}
const dayLabel = (day: string) =>
  new Date(`${day}T00:00:00Z`).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<div class="hf-toolbar">
  <details class="hf-refsw">
    <summary class="hf-btn hf-branch-btn" aria-label={`Commits on branch ${refName}`}>
      <svg class="hf-i"><use href="#i-branch" /></svg> <code>{refName}</code>
      <svg class="hf-i hf-caret"><use href="#i-chev" /></svg>
    </summary>
    <div class="hf-refsw-pop" role="region" aria-label="Switch branch">
      <div class="hf-refsw-group">
        {/* A popover's group label, not a section of the document — see RefSwitcher.astro.
            The <ul> carries the name so a screen reader still announces "Branches, list". */}
        <p class="hf-refsw-grouphead" aria-hidden="true">Branches</p>
        <ul aria-label="Branches">
          {repo.branches.map((b) => (
            <li>
              <a href={commitsUrl(repo.slug, b.name)} class:list={{ 'is-current': b.name === refName }} aria-current={b.name === refName ? 'true' : undefined}>
                <svg class="hf-i"><use href="#i-branch" /></svg>
                <code>{b.name}</code>
                {b.name === repo.defaultBranch && <span class="hf-refsw-default">default</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </details>
  <span class="hf-muted"><b>{formatInt(branch.commits.length)}</b> commit{branch.commits.length === 1 ? '' : 's'}</span>
</div>

<div class="hf-commit-groups">
  {groups.map((g) => (
    <section class="hf-commit-group">
      <h2 class="hf-commit-day"><svg class="hf-i"><use href="#i-history" /></svg> Commits on {dayLabel(g.day)}</h2>
      <div class="hf-card hf-commit-list">
        {g.commits.map((c) => (
          <div class="hf-commit-row">
            <span class="hf-avatar hf-avatar--sm" aria-hidden="true">{initials(c.author.name)}</span>
            <div class="hf-commit-main">
              <a class="hf-commit-subject" href={commitUrl(repo.slug, c.sha)}>{c.subject}</a>
              <span class="hf-commit-sub">
                <span class="hf-commit-author">{c.author.name}</span>
                <span class="hf-dot">·</span>
                <span class={`hf-age t-${heatFor(c.commitDate, now)}`} title={c.commitDate}>{relativeTime(c.commitDate, now)}</span>
              </span>
            </div>
            <span class="hf-commit-stats" title={`${c.stats.filesChanged} file${c.stats.filesChanged === 1 ? '' : 's'} changed`}>
              <b class="hf-adds">+{formatInt(c.stats.additions)}</b>
              <b class="hf-dels">−{formatInt(c.stats.deletions)}</b>
            </span>
            <span class="hf-commit-sha">
              <button type="button" aria-label={`Copy sha ${c.sha.slice(0, 7)}`} data-copy={c.sha}><code>{c.sha.slice(0, 7)}</code> <svg class="hf-i"><use href="#i-copy" /></svg></button>
            </span>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

{pageCount > 1 && (
  <nav class="hf-pager" aria-label="Commit pages">
    <a class="hf-btn hf-btn--sm" href={page > 1 ? commitsUrl(repo.slug, refName, page - 1) : undefined} aria-disabled={page <= 1 ? 'true' : undefined}>
      <svg class="hf-i"><use href="#i-arrow-left" /></svg> Newer
    </a>
    <span>Page {page} of {pageCount}</span>
    <a class="hf-btn hf-btn--sm" href={page < pageCount ? commitsUrl(repo.slug, refName, page + 1) : undefined} aria-disabled={page >= pageCount ? 'true' : undefined}>
      Older <svg class="hf-i"><use href="#i-arrow-right" /></svg>
    </a>
  </nav>
)}
