---
/**
 * Client-side renderer for ```mermaid fences (0.2.0). Include this on a page only when its
 * rendered markdown actually holds a diagram (`containsMermaid()` in `src/lib/markdown.ts`)
 * — mermaid is heavyweight, and this is what keeps it off every other page.
 *
 * The renderer itself is `web/js/mermaid.js`, which lazily imports the vendored mermaid
 * build in `web/vendor/mermaid/` (see the README there). A page that includes this component
 * twice emits the same script URL twice, which the browser loads once.
 */
import { withBase } from '../lib/base';
---
<script is:inline type="module" src={withBase('/js/mermaid.js')}></script>
