---
/**
 * Repo listing: search / filter / sort / paginate.
 *
 * Was RepoListing.svelte until 0.4.0. It is now **progressive enhancement rather than
 * hydration**: this component server-renders the complete initial listing (the default query,
 * page 1 — exactly what a visitor with no JavaScript gets), and `web/js/hf-repo-listing.js`
 * adopts that DOM and takes over re-rendering. Nothing is rendered twice.
 *
 * Three things the element needs from the server, and why they are in the markup rather than
 * in the script:
 *  - `#hf-repo-data`, the full `RepoSummary[]`. Filtering happens over every repo, not just
 *    the page that is showing, and the payload is small enough that making the first
 *    interaction wait on a fetch would be the wrong trade.
 *  - `<template>`s for a card and its repeated parts. The element clones these, so card
 *    markup has exactly ONE definition — this file — instead of a copy living in a JS string
 *    where it would quietly drift from `RepoCard.astro`.
 *  - Controls that only appear in some states (Clear, the empty state, the pager) are always
 *    in the DOM and toggled with `hidden`, so the element never constructs chrome.
 */
import RepoCard from './RepoCard.astro';
import { withBase } from '../lib/base';
import { DEFAULT_HEAT, type HeatThresholds } from '../lib/format';
import { applyListing, defaultQuery, facets as computeFacets, SORT_KEYS, SORT_LABELS, type RepoSummary } from '../lib/listing';

interface Props {
  repos: RepoSummary[];
  pageSize: number;
  now: number;
  /** Recency-accent day boundaries (`theme.heat`), forwarded to every card. */
  heatDays?: HeatThresholds;
  /**
   * Path this listing lives at, used by every link it emits that is not a bare query string
   * (tag chips, and the pager's "no filters left" href). Defaults to the site-wide listing;
   * `/orgs/<slug>/repos/` passes its own so filtering inside an organization stays inside it.
   * Must end in a slash.
   */
  basePath?: string;
}
const { repos, pageSize, now, heatDays = DEFAULT_HEAT, basePath = withBase('/repos/') } = Astro.props;

// The build renders the default query. A visitor arriving at `?tag=cli` gets this same HTML
// and the element applies their query on load — a static build cannot know the query string.
const query = defaultQuery(pageSize);
const result = applyListing(repos, query);
const facets = computeFacets(repos);

const tagHref = (tag: string) => `${basePath}?tag=${encodeURIComponent(tag)}`;
const KINDS: Array<[string, string]> = [['all', 'All'], ['normal', 'Repos'], ['template', 'Templates']];

// Escaped so a description containing `</script>` cannot end the tag early. `<` is
// ordinary JSON, so JSON.parse in the browser sees the original text.
const payload = JSON.stringify(repos).replace(/</g, '\u003c');
---
<hf-repo-listing
  data-base-path={basePath}
  data-page-size={String(pageSize)}
  data-now={String(now)}
  data-heat={JSON.stringify(heatDays)}
>
  <div class="hf-listing" id="listing-top">
    <div class="hf-listing-toolbar">
      <label class="hf-input hf-input--search">
        <svg class="hf-i"><use href="#i-search" /></svg>
        <input
          type="search"
          placeholder="Search repositories…"
          value={query.q}
          aria-label="Search repositories"
          data-hf-q
        />
      </label>
      <label class="hf-select">
        <span>Sort</span>
        <select aria-label="Sort repositories" data-hf-sort>
          {SORT_KEYS.map((k) => <option value={k} selected={k === query.sort}>{SORT_LABELS[k]}</option>)}
        </select>
      </label>
      <div class="hf-seg" role="group" aria-label="Repository kind">
        {KINDS.map(([k, label]) => (
          <button type="button" class={query.kind === k ? 'is-active' : undefined} data-hf-kind={k}>
            {label}{k === 'template' && facets.templates ? ` (${facets.templates})` : ''}
          </button>
        ))}
      </div>
      <span class="hf-listing-count" aria-live="polite" data-hf-count>{result.total} of {repos.length}</span>
      <button type="button" class="hf-btn hf-btn--ghost hf-btn--sm" data-hf-clear hidden>Clear</button>
    </div>

    {(facets.languages.length > 0 || facets.tags.length > 0) && (
      <div class="hf-facets">
        {facets.languages.length > 0 && (
          <div class="hf-facet-group">
            <span class="hf-facet-label">Language</span>
            {facets.languages.map((f) => (
              <button type="button" class="hf-chip" aria-pressed="false" data-hf-facet="languages" data-hf-value={f.name}>
                {f.name} <small>{f.count}</small>
              </button>
            ))}
          </div>
        )}
        {facets.tags.length > 0 && (
          <div class="hf-facet-group">
            <span class="hf-facet-label">Tags</span>
            {facets.tags.map((f) => (
              <button type="button" class="hf-chip" aria-pressed="false" data-hf-facet="tags" data-hf-value={f.name}>
                {f.name} <small>{f.count}</small>
              </button>
            ))}
          </div>
        )}
      </div>
    )}

    <div class="hf-empty" data-hf-empty hidden={result.items.length > 0}>
      <svg class="hf-i"><use href="#i-repo" /></svg>
      {repos.length === 0 ? (
        <p><strong>No repositories yet.</strong> Add some to <code>frznforge.config.ts</code> and run <code>npm run ingest</code>.</p>
      ) : (
        <Fragment>
          <p><strong>Nothing matches.</strong> Try fewer filters.</p>
          <button type="button" class="hf-btn hf-btn--ghost hf-btn--sm" data-hf-clear>Clear filters</button>
        </Fragment>
      )}
    </div>

    <div class="hf-repo-grid hf-repo-grid--listing" data-hf-grid hidden={result.items.length === 0}>
      {result.items.map((repo) => <RepoCard repo={repo} now={now} tagHref={tagHref} heatDays={heatDays} />)}
    </div>

    <nav class="hf-pager" aria-label="Pagination" data-hf-pager hidden={result.pageCount <= 1}>
      <a class="hf-btn hf-btn--ghost hf-btn--sm" href={basePath} aria-disabled="true" data-hf-prev>← Prev</a>
      <span data-hf-pageinfo>Page {result.page} of {result.pageCount}</span>
      <a class="hf-btn hf-btn--ghost hf-btn--sm" href="?page=2" aria-disabled={result.pageCount <= 1 ? 'true' : 'false'} data-hf-next>Next →</a>
    </nav>
  </div>

  <script is:inline type="application/json" data-hf-repos set:html={payload}></script>

  <template data-hf-card>
    <article class="hf-repo-card" data-slug>
      <div class="hf-repo-top">
        <span class="hf-repo-icon"><svg class="hf-i"><use href="#i-repo" /></svg></span>
        <a class="hf-repo-name"></a>
        <span class="hf-tag hf-tag--template">Template</span>
      </div>
      <p class="hf-repo-desc"></p>
      <div class="hf-repo-tags"></div>
      <div class="hf-repo-foot">
        <span class="hf-langs"></span>
        <span class="hf-age"></span>
      </div>
    </article>
  </template>
  <template data-hf-card-tag><a class="hf-tag"></a></template>
  <template data-hf-card-lang><span><i class="hf-lang-dot"></i></span></template>
  <template data-hf-card-nolang><span class="hf-muted"></span></template>
</hf-repo-listing>

<script is:inline type="module" src={withBase('/js/hf-repo-listing.js')}></script>
