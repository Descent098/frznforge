---
import HearthLayout from '../../../layouts/designs/HearthLayout.astro';

// Deterministic pseudo-random contribution cells (52 weeks x 7 days).
// Column-major: index i -> week = floor(i / 7), day = i % 7. Week 51 = most recent.
const cells: { temp: string; level: number }[] = [];
for (let i = 0; i < 52 * 7; i++) {
  const week = Math.floor(i / 7);
  const day = i % 7;
  // LCG-ish hash on the index, stable across builds
  const r = ((i * 9301 + 49297) % 233280) / 233280;
  const r2 = (((i + 17) * 7919 + 104729) % 65521) / 65521;
  // activity bias: more recent -> busier; weekends quieter
  const recency = week / 51;
  const weekend = day === 0 || day === 6 ? 0.55 : 1;
  const p = (0.25 + 0.55 * recency) * weekend;
  let level = 0;
  if (r < p) level = 1 + Math.floor(r2 * 4 * (0.45 + 0.55 * recency));
  if (level > 4) level = 4;
  const temp = week >= 42 ? 'hot' : week >= 26 ? 'warm' : 'cold';
  cells.push({ temp, level });
}
const months = ['Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'];
