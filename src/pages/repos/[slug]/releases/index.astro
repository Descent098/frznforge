---
/**
 * Releases index. Works for both origins: `resolveReleases` prefers provider-imported
 * releases and falls back to annotated tags, so a repo whose remote could not be fetched
 * this build still renders whatever git knows about.
 */
import Base from '../../../../layouts/Base.astro';
import RepoHeader from '../../../../components/RepoHeader.astro';
import ReleaseCard from '../../../../components/ReleaseCard.astro';
import { resolveReleases } from '../../../../lib/routes';
import { getData } from '../../../../lib/site';
import type { Repo } from '../../../../lib/data/schema';

export async function getStaticPaths() {
  const data = await getData();
  return data.repos.filter((r) => !r.empty).map((repo) => ({ params: { slug: repo.slug }, props: { repo } }));
}

interface Props { repo: Repo }
const { repo } = Astro.props;
const now = new Date();
const releases = resolveReleases(repo);

const PROVIDER_LABELS = { github: 'GitHub', gitlab: 'GitLab', gitea: 'Gitea', forgejo: 'Forgejo' } as const;
const providerLabel = repo.source.type === 'local' ? null : PROVIDER_LABELS[repo.source.type];

/** "Latest" marks the newest release a visitor should actually install. */
const latestIndex = releases.findIndex((r) => !r.prerelease);

/**
 * Empty state depends on where releases were *supposed* to come from: telling someone with a
 * provider-backed repo to run `git tag -a` would be wrong advice.
 */
const providerEmpty = releases.length === 0 && repo.releaseMode === 'provider' && providerLabel !== null;
---
<Base title={`Releases · ${repo.name}`} description={repo.description ?? undefined} active="repos">
  <div class="hf-container">
    <RepoHeader repo={repo} active="releases" />

    <div class="hf-repo-main" style="margin-top:16px">
      {releases.length === 0 ? (
        <div class="hf-card hf-empty">
          <svg class="hf-i"><use href="#i-package" /></svg>
          {providerEmpty ? (
            <p><strong>No releases published on {providerLabel} yet.</strong> They will appear here on the next build once the first one is published.</p>
          ) : (
            <p><strong>No releases yet.</strong> Releases are created from annotated tags — <code>git tag -a v1.0.0 -m '...'</code></p>
          )}
        </div>
      ) : (
        <ol class="hf-release-list" aria-label={`Releases of ${repo.name}, newest first`}>
          {releases.map((release, i) => (
            <li>
              <ReleaseCard repo={repo} release={release} isLatest={i === latestIndex} providerLabel={providerLabel} now={now} />
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
</Base>
