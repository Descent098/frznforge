---
import Base from '../../../../../layouts/Base.astro';
import RepoHeader from '../../../../../components/RepoHeader.astro';
import CommitList from '../../../../../components/CommitList.astro';
import CopyScript from '../../../../../components/CopyScript.astro';
import { refFromSlug, refSlug } from '../../../../../lib/routes';
import { getData } from '../../../../../lib/site';
import type { Repo } from '../../../../../lib/data/schema';

export async function getStaticPaths() {
  const data = await getData();
  return data.repos.flatMap((repo) =>
    repo.empty
      ? []
      : repo.branches.map((b) => ({
          params: { slug: repo.slug, ref: refSlug(b.name) },
          props: { repo },
        })),
  );
}

interface Props { repo: Repo }
const { repo } = Astro.props;
const refName = refFromSlug(Astro.params.ref!);
---
<Base title={`Commits on ${refName} · ${repo.name}`} description={repo.description ?? undefined} active="repos">
  <div class="hf-container">
    <RepoHeader repo={repo} active="commits" heading={`Commits on ${refName} · ${repo.name}`} />
    <div class="hf-repo-main" style="margin-top:16px">
      <CommitList repo={repo} refName={refName} page={1} />
    </div>
  </div>
  <CopyScript />
</Base>
