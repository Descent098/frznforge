---
import Base from '../../../layouts/Base.astro';
import RepoHeader from '../../../components/RepoHeader.astro';
import RefSwitcher from '../../../components/RefSwitcher.astro';
import FileTable from '../../../components/FileTable.astro';
import { archiveUrl, browsableRefs, commitUrl, commitsUrl, getRepoRoutes } from '../../../lib/routes';
import MermaidRenderer from '../../../components/MermaidRenderer.astro';
import { containsMermaid, isMarkdownPath, isTrustedSource, renderMarkdown } from '../../../lib/markdown';
import { formatBytes, formatInt, getConfig, getData, heatFor, initials, prettyUrl, relativeTime } from '../../../lib/site';
import type { Repo } from '../../../lib/data/schema';

export async function getStaticPaths() {
  const data = await getData();
  return getRepoRoutes(data).map(({ slug, repo }) => ({ params: { slug }, props: { repo } }));
}

interface Props { repo: Repo }
const { repo } = Astro.props;
const cfg = await getConfig();
const now = new Date();

const defaultBranch = repo.branches.find((b) => b.name === repo.defaultBranch) ?? null;
const headCommit = defaultBranch ? repo.commits[defaultBranch.head] ?? null : null;
const latestTag = repo.gitTags.length ? [...repo.gitTags].sort((a, b) => b.date.localeCompare(a.date))[0]! : null;
const defaultRef = repo.defaultBranch ? browsableRefs(repo).find((r) => r.isDefault) ?? null : null;
const defaultArchive = repo.defaultBranch
  ? repo.archives.find((a) => a.kind === 'branch' && a.ref === repo.defaultBranch) ?? null
  : null;


/** Root-level entries of the default-branch tree (dirs first, then files). */
const rootEntries = repo.tree.filter((e) => !e.path.includes('/'));

const readmeHtml = repo.readme
  ? isMarkdownPath(repo.readme.path)
    ? renderMarkdown(repo.readme.content, { trusted: isTrustedSource(repo.source), mermaid: cfg.markdown.mermaid })
    : `<pre tabindex="0">${repo.readme.content.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!)}</pre>`
  : null;

const links: Array<{ key: string; label: string; icon: string; url: string }> = [];
if (repo.links.homepage) links.push({ key: 'homepage', label: 'Homepage', icon: '#i-globe', url: repo.links.homepage });
if (repo.links.issues) links.push({ key: 'issues', label: 'Issue tracker', icon: '#i-bolt', url: repo.links.issues });
if (repo.links.donations) links.push({ key: 'donations', label: 'Donations', icon: '#i-heart', url: repo.links.donations });
if (repo.links.upstream) links.push({ key: 'upstream', label: 'Upstream', icon: /github\.com/.test(repo.links.upstream) ? '#i-github' : '#i-forge', url: repo.links.upstream });

/** Clone URL: the upstream if it looks like a git host, else nothing (no running git server here). */
const cloneUrl = repo.links.upstream ? repo.links.upstream.replace(/\/+$/, '') + (repo.links.upstream.endsWith('.git') ? '' : '.git') : null;
const upstreamHost = repo.links.upstream ? new URL(repo.links.upstream).hostname.replace(/^www\./, '') : null;
const heat = heatFor(repo.updatedAt, now, cfg.theme.heat);
---
<Base title={repo.name} description={repo.description ?? `${repo.name} — ${cfg.owner.name}`} active="repos">
  <div class="hf-container">
    <RepoHeader repo={repo} active="code" />

    {repo.empty ? (
      <section class="hf-card hf-empty" style="margin-top:16px">
        <svg class="hf-i"><use href="#i-repo" /></svg>
        <p><strong>This repository is empty.</strong> It has no commits on any branch yet.</p>
      </section>
    ) : (
      <div class="hf-repo-body" style="margin-top:16px">
        <div class="hf-repo-main">
          <div class="hf-toolbar">
            {defaultRef && <RefSwitcher repo={repo} current={defaultRef} path="" />}
            <div class="hf-toolbar-right">
              {cloneUrl ? (
                <details class="hf-clone" data-clone-url={cloneUrl}>
                  <summary class="hf-btn hf-btn--primary"><svg class="hf-i"><use href="#i-download" /></svg> Clone <svg class="hf-i hf-caret"><use href="#i-chev" /></svg></summary>
                  <div class="hf-clone-pop" role="region" aria-label="Clone options">
                    {/* Popover label, not a document section — a heading here landed an <h4>
                        at the top of the page outline, before any h1. The region above already
                        carries the accessible name. */}
                    <p class="hf-clone-head">Clone <span class="hf-tabs-mini"><span class="is-on">HTTPS</span></span></p>
                    <div class="hf-clone-url"><code>{cloneUrl}</code><button type="button" aria-label="Copy URL" data-copy={cloneUrl}><svg class="hf-i"><use href="#i-copy" /></svg></button></div>
                    <p>This site is a read-only mirror. Clone from the upstream on {upstreamHost}.</p>
                    {defaultArchive && (
                      <a class="hf-clone-item" href={archiveUrl(repo.slug, defaultArchive.ref)}>
                        <svg class="hf-i"><use href="#i-zip" /></svg> Download ZIP <small>{formatBytes(defaultArchive.bytes)}</small>
                      </a>
                    )}
                  </div>
                </details>
              ) : (
                defaultArchive && (
                  <a class="hf-btn" href={archiveUrl(repo.slug, defaultArchive.ref)}>
                    <svg class="hf-i"><use href="#i-zip" /></svg> Download ZIP <small class="hf-muted">{formatBytes(defaultArchive.bytes)}</small>
                  </a>
                )
              )}
            </div>
          </div>

          {headCommit && (
            <div class="hf-commit-bar">
              <span class="hf-author"><span class="hf-avatar hf-avatar--sm" aria-hidden="true">{initials(headCommit.author.name)}</span> {headCommit.author.name}</span>
              <a class="hf-msg" href={commitUrl(repo.slug, headCommit.sha)}>{headCommit.subject}</a>
              <span class="hf-dot">·</span>
              <code class="hf-sha">{headCommit.sha.slice(0, 7)}</code>
              <span class="hf-dot">·</span>
              <span class={`hf-age t-${heatFor(headCommit.commitDate, now, cfg.theme.heat)}`} title={headCommit.commitDate}>{relativeTime(headCommit.commitDate, now)}</span>
              {repo.defaultBranch && (
                <a class="hf-commits-link" href={commitsUrl(repo.slug, repo.defaultBranch)}><svg class="hf-i"><use href="#i-history" /></svg> <b>{formatInt(repo.commitCount)}</b> commits</a>
              )}
            </div>
          )}

          {rootEntries.length > 0 && repo.defaultBranch ? (
            <FileTable repo={repo} refName={repo.defaultBranch} entries={rootEntries} />
          ) : (
            <div class="hf-card hf-empty">
              <svg class="hf-i"><use href="#i-folder" /></svg>
              <p><strong>No files on <code>{repo.defaultBranch}</code>.</strong> The latest commit left the tree empty.</p>
            </div>
          )}

          {readmeHtml && repo.readme && (
            <article class="hf-card hf-readme-card">
              <div class="hf-card-head">
                <svg class="hf-i"><use href="#i-note" /></svg>
                <h2>README</h2>
                <code>{repo.readme.path}</code>
              </div>
              <div class="hf-card-body hf-md" set:html={readmeHtml} />
              {readmeHtml && containsMermaid(readmeHtml) && <MermaidRenderer />}
            </article>
          )}
        </div>

        <aside class="hf-card hf-about" aria-labelledby="about-h">
          <section class="hf-about-section">
            <h2 id="about-h">About</h2>
            {repo.description ? <p>{repo.description}</p> : <p class="hf-muted">No description provided.</p>}
            {links.length > 0 && (
              <ul class="hf-about-links">
                {links.map((l) => (
                  <li><svg class="hf-i"><use href={l.icon} /></svg><span class="hf-lbl">{l.label}</span><a href={l.url} rel="noopener">{prettyUrl(l.url)}</a></li>
                ))}
              </ul>
            )}
          </section>
          {repo.tags.length > 0 && (
            <section class="hf-about-section">
              <h2>Tags</h2>
              <div class="hf-about-tags">
                {repo.tags.map((t) => <a class="hf-tag" href={`/repos/?tag=${encodeURIComponent(t)}`}>{t}</a>)}
              </div>
            </section>
          )}
          <section class="hf-about-section">
            <ul class="hf-about-meta">
              {repo.license && <li><svg class="hf-i"><use href="#i-scale" /></svg> <b>{repo.license.spdx ?? 'Custom'}</b>&nbsp;license{repo.license.file && <span class="hf-muted">&nbsp;· {repo.license.file}</span>}</li>}
              <li><svg class="hf-i"><use href="#i-pulse" /></svg> <b>{formatInt(repo.commitCount)}</b>&nbsp;commits · last <span class={`hf-age t-${heat}`}>{relativeTime(repo.updatedAt, now)}</span></li>
              {latestTag && <li><svg class="hf-i"><use href="#i-tag" /></svg> <b>{repo.gitTags.length}</b>&nbsp;tags · latest <code>{latestTag.name}</code></li>}
              {repo.createdAt && <li><svg class="hf-i"><use href="#i-history" /></svg> created <span class="hf-age t-cold" title={repo.createdAt}>{relativeTime(repo.createdAt, now)}</span></li>}
            </ul>
          </section>
          {repo.languages.length > 0 && (
            <section class="hf-about-section">
              <h2>Languages</h2>
              <div class="hf-langbar" aria-hidden="true">
                {repo.languages.map((l) => <span style={`width:${l.percent}%;background:${l.color ?? 'var(--hf-lang-other)'}`}></span>)}
              </div>
              <div class="hf-lang-legend">
                <ul>
                  {repo.languages.map((l) => <li><span><i class="hf-lang-dot" style={`background:${l.color ?? 'var(--hf-lang-other)'}`}></i><b>{l.name}</b></span><i>{l.percent}%</i></li>)}
                </ul>
              </div>
            </section>
          )}
          {repo.contributors.length > 0 && (
            <section class="hf-about-section">
              <h2>Contributors <span class="hf-count hf-count--plain">{repo.contributors.length}</span></h2>
              <div class="hf-contributors">
                {repo.contributors.map((c) => (
                  <span class="hf-contributor"><span class="hf-avatar hf-avatar--sm" aria-hidden="true">{initials(c.name)}</span><strong>{c.name}</strong><small>{formatInt(c.commits)} commit{c.commits === 1 ? '' : 's'}</small></span>
                ))}
              </div>
            </section>
          )}
        </aside>
      </div>
    )}
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.classList.add('is-copied');
          setTimeout(() => btn.classList.remove('is-copied'), 1200);
        } catch {}
      });
    });
  </script>
</Base>
