---
/**
 * /orgs/<slug>/repos/ — the Phase 2 repo listing island, scoped to one organization.
 *
 * Same component and the same client-side filter/sort/search behaviour as /repos/; only the
 * repo set differs. When the org has no members the island is skipped entirely: its generic
 * "add some repos to frznforge.config.ts" empty state would be wrong advice here, where the
 * fix is membership, not ingestion.
 */
import Base from '../../../../layouts/Base.astro';
import RepoListing from '../../../../components/RepoListing.svelte';
import type { Organization, Repo } from '../../../../lib/data/schema';
import { summarize } from '../../../../lib/listing';
import { getOrgRoutes, orgReposUrl, orgUrl } from '../../../../lib/routes';
import { getConfig, getData } from '../../../../lib/site';
import '../../../../styles/orgs.css';

export async function getStaticPaths() {
  const data = await getData();
  return getOrgRoutes(data).map(({ slug, org, repos }) => ({ params: { slug }, props: { org, repos } }));
}

interface Props { org: Organization; repos: Repo[] }
const { org, repos } = Astro.props;
const cfg = await getConfig();
const summaries = repos.map(summarize);
const now = Date.now();
---
<Base title={`${org.name} repositories`} description={`All ${summaries.length} repositories in ${org.name}`} active="orgs">
  <div class="hf-container">
    <header class="hf-page-head">
      <a class="hf-org-back" href={orgUrl(org.slug)} aria-label={`Back to the ${org.name} overview`}>
        <svg class="hf-i"><use href="#i-arrow-left" /></svg> {org.name}
      </a>
      <h1>{org.name} repositories</h1>
      <p>
        {summaries.length} repositor{summaries.length === 1 ? 'y' : 'ies'} in this organization ·
        search, filter and sort. Heat = how recently each repo moved.
      </p>
    </header>
    {summaries.length ? (
      /* basePath keeps tag chips and the no-JS pager inside this organization. */
      <RepoListing client:load repos={summaries} pageSize={cfg.listing.pageSize} now={now} basePath={orgReposUrl(org.slug)} />
    ) : (
      <div class="hf-empty hf-card">
        <svg class="hf-i"><use href="#i-repo" /></svg>
        <p>
          <strong>{org.name} has no repositories yet.</strong> Add <code>org: '{org.slug}'</code> to a repo
          source, or list the repo under this organization's <code>repos</code> in
          <code>frznforge.config.ts</code>, then run <code>npm run ingest</code>.
        </p>
      </div>
    )}
  </div>
</Base>
