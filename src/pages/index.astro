---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContributionGraph from '../components/ContributionGraph.astro';
import RepoCard from '../components/RepoCard.svelte';
import { buildActivity } from '../lib/activity';
import { buildContribGraph } from '../lib/contrib';
import { summarize } from '../lib/listing';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import { withBase } from '../lib/base';
import { containsMermaid, renderMarkdown } from '../lib/markdown';
import { commitsUrl, tagsUrl } from '../lib/routes';
import { heatFor, relativeTimeShort } from '../lib/format';
import {
  aggregateLanguages,
  commitsSince,
  earliestCommit,
  formatInt,
  getConfig,
  getData,
  initials,
  monthYear,
  prettyUrl,
  yearsSince,
} from '../lib/site';

const cfg = await getConfig();
const data = await getData();
const now = new Date();

const entries = await getCollection('profile');
const profile = entries[0] ?? null;
const fm = profile?.data;
/**
 * Rendered with the site's own `renderMarkdown()` rather than Astro's markdown pipeline.
 *
 * One engine for every piece of markdown on the site — READMEs, notes, release bodies and
 * these two — means one set of rules, and in particular one place where headings are demoted
 * a level so the page chrome keeps sole ownership of the `<h1>`. Astro's pipeline would need
 * a rehype plugin to do the same, and reaching for one now means installing
 * `@astrojs/markdown-remark`, which this project does not ship.
 *
 * `entry.body` is the markdown with the frontmatter already stripped by the collection.
 */
const profileHtml = profile?.body?.trim() ? renderMarkdown(profile.body, { mermaid: cfg.markdown.mermaid }) : null;

const repoCount = data.repos.length;
// The "recent" window is the hot bucket of the recency accent (`theme.heat.hot`, default 7
// days), so the KPI copy and the orange accent always agree on what counts as recent.
const heatDays = cfg.theme.heat;
const hotWindow = heatDays.hot === 7 ? 'this week' : `in the last ${heatDays.hot} days`;
const commitsThisYear = commitsSince(data.repos, 365, now);
const commitsRecent = commitsSince(data.repos, heatDays.hot, now);
const firstCommit = earliestCommit(data.repos);
const years = yearsSince(firstCommit, now);
const languages = aggregateLanguages(data.repos, 5);
const templates = data.repos.filter((r) => r.template).length;
const touchedRecently = data.repos.filter((r) => heatFor(r.updatedAt, now, heatDays) === 'hot').length;

const pinnedSlugs = fm?.pinned ?? [];
const pinned = pinnedSlugs
  .map((slug) => data.repos.find((r) => r.slug === slug))
  .filter((r): r is NonNullable<typeof r> => {
    return Boolean(r);
  })
  .map(summarize);
for (const slug of pinnedSlugs) {
  if (!data.repos.some((r) => r.slug === slug)) console.warn(`[frznforge] profile.md pins unknown repo "${slug}"`);
}

const graph = buildContribGraph(data.repos, fm?.identities ?? [], now, heatDays);
const activity = buildActivity(data.repos, 6);

const forgeLabels: Record<string, string> = { github: 'GitHub', gitlab: 'GitLab', codeberg: 'Codeberg', forgejo: 'Forgejo', gitea: 'Gitea' };
const forges = Object.entries(fm?.forges ?? {}).filter(([, url]) => Boolean(url)) as Array<[string, string]>;
---
<Base title={cfg.site.title} description={fm?.bio ?? cfg.site.description} active="profile">
  <div class="hf-container">
    <section class="hf-hero" aria-labelledby="owner-name">
      <div class="hf-avatar hf-avatar--xl" aria-hidden="true">{initials(cfg.owner.name)}</div>
      <div class="hf-hero-id">
        <div class="hf-hero-name">
          <h1 id="owner-name">{cfg.owner.name}</h1>
          <span class="hf-handle">@{cfg.owner.handle}</span>
        </div>
        {fm?.bio && <p class="hf-hero-bio">{fm.bio}</p>}
        <ul class="hf-hero-meta">
          {fm?.location && <li><svg class="hf-i"><use href="#i-pin" /></svg> {fm.location}</li>}
          {fm?.workplace && <li><svg class="hf-i"><use href="#i-briefcase" /></svg> {fm.workplace}</li>}
          {fm?.school && <li><svg class="hf-i"><use href="#i-school" /></svg> {fm.school}</li>}
          {fm?.email && <li><svg class="hf-i"><use href="#i-mail" /></svg> <a href={`mailto:${fm.email}`}>{fm.email}</a></li>}
        </ul>
        <div class="hf-hero-links">
          {(fm?.sites ?? []).map((url, i) => (
            <a class:list={['hf-pill', { 'hf-pill--accent': i === 0 }]} href={url} rel="me"><svg class="hf-i"><use href="#i-globe" /></svg> {prettyUrl(url)}</a>
          ))}
          {fm?.linkedin && <a class="hf-pill" href={fm.linkedin} rel="me"><svg class="hf-i"><use href="#i-linkedin" /></svg> LinkedIn</a>}
          {forges.map(([key, url]) => (
            <a class="hf-pill" href={url} rel="me"><svg class="hf-i"><use href={key === 'github' ? '#i-github' : '#i-forge'} /></svg> {forgeLabels[key] ?? key}</a>
          ))}
        </div>
      </div>

      <div class="hf-hero-kpis" aria-label="Profile statistics">
        <div class="hf-kpi hf-kpi--ember">
          <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-repo" /></svg> Repositories</div>
          <div class="hf-kpi-value">{formatInt(repoCount)}</div>
          <div class="hf-kpi-sub">
            {touchedRecently > 0 ? <><span class="t-hot">{touchedRecently} touched</span> {hotWindow}</> : `none touched ${hotWindow}`}
            {templates > 0 && <> · {templates} template{templates === 1 ? '' : 's'}</>}
          </div>
        </div>
        <div class="hf-kpi hf-kpi--ember">
          <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-commit" /></svg> Commits this year</div>
          <div class="hf-kpi-value">{formatInt(commitsThisYear)}</div>
          <div class="hf-kpi-sub">{commitsRecent > 0 ? <><span class="t-hot">+{formatInt(commitsRecent)}</span> in the last {heatDays.hot} days</> : `none in the last ${heatDays.hot} days`}</div>
        </div>
        <div class="hf-kpi hf-kpi--ice">
          <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-history" /></svg> Years of history</div>
          <div class="hf-kpi-value">{years}</div>
          <div class="hf-kpi-sub">{firstCommit ? <>first commit <span class="t-cold">{monthYear(firstCommit)}</span></> : 'no commits yet'}</div>
        </div>
        <div class="hf-kpi hf-kpi-langs">
          <div class="hf-kpi-label"><svg class="hf-i"><use href="#i-code" /></svg> Top languages</div>
          {languages.length ? (
            <>
              <div class="hf-langbar" aria-hidden="true">
                {languages.map((l) => <span style={`width:${l.percent}%;background:${l.color ?? 'var(--hf-lang-other)'}`}></span>)}
              </div>
              <div class="hf-lang-legend">
                <ul>
                  {languages.map((l) => <li><i class="hf-lang-dot" style={`background:${l.color ?? 'var(--hf-lang-other)'}`}></i><b>{l.name}</b><i>{l.percent}%</i></li>)}
                </ul>
              </div>
            </>
          ) : (
            <div class="hf-kpi-sub">No code detected yet.</div>
          )}
        </div>
      </div>
    </section>

    <section class:list={['hf-two-col', { 'hf-two-col--single': activity.length === 0 }]} style="margin-top:16px">
      {profileHtml ? (
        <article class="hf-card hf-readme" aria-labelledby="profile-readme-h">
          {/* The card owns an h2 so the outline cannot skip a level into the body: user
              markdown starts wherever the author started it, and a profile.md whose first
              line is `## …` would otherwise step h1 -> h3. Hidden, because the card is
              obviously the profile README on screen. */}
          <h2 class="hf-sr" id="profile-readme-h">Profile README</h2>
          <div class="hf-md" set:html={profileHtml} />
          {containsMermaid(profileHtml) && <MermaidRenderer />}
        </article>
      ) : (
        <div></div>
      )}
      {activity.length > 0 && (
        <aside class="hf-card hf-activity" aria-labelledby="activity-h">
          <div class="hf-card-head">
            <svg class="hf-i"><use href="#i-pulse" /></svg>
            <h2 id="activity-h">Recent activity</h2>
          </div>
          <ul class="hf-activity-list">
            {activity.map((e) => {
              const heat = heatFor(e.date, now, heatDays);
              return (
                <li>
                  <span class={`hf-act-icon t-${heat}`}><svg class="hf-i"><use href={e.type === 'tag' ? '#i-tag' : '#i-commit'} /></svg></span>
                  {e.type === 'push' ? (
                    <span class="hf-act-text">Pushed {e.count} commit{e.count === 1 ? '' : 's'} to <a href={commitsUrl(e.repo, e.branch)}>{e.repo}</a>/<code>{e.branch}</code></span>
                  ) : (
                    <span class="hf-act-text">Tagged <code>{e.tag}</code> in <a href={tagsUrl(e.repo)}>{e.repo}</a></span>
                  )}
                  <span class={`hf-age t-${heat}`} title={e.date}>{relativeTimeShort(e.date, now)}</span>
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </section>

    <section aria-labelledby="pinned-h" style="margin-top:28px">
      <div class="hf-section-head">
        <h2 id="pinned-h">{pinned.length ? 'Pinned' : 'Repositories'}</h2>
        <p>Heat = how recently each repo moved</p>
        <a class="hf-more" href={withBase('/repos/')}>View all {repoCount} repositor{repoCount === 1 ? 'y' : 'ies'} →</a>
      </div>
      {pinned.length ? (
        <div class="hf-repo-grid">
          {pinned.map((repo) => <RepoCard repo={repo} now={now.getTime()} heatDays={heatDays} />)}
        </div>
      ) : repoCount ? (
        <div class="hf-repo-grid">
          {data.repos.slice(0, 6).map((r) => <RepoCard repo={summarize(r)} now={now.getTime()} heatDays={heatDays} />)}
        </div>
      ) : (
        <div class="hf-empty hf-card">
          <svg class="hf-i"><use href="#i-repo" /></svg>
          <p><strong>No repositories yet.</strong> Add some to <code>frznforge.config.ts</code> and run <code>npm run ingest</code>.</p>
        </div>
      )}
    </section>

    {!graph.total && repoCount === 0 ? null : (
      <div style="margin-top:16px">
        <ContributionGraph graph={graph} />
      </div>
    )}
  </div>
</Base>
