{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "docs",
    "tests/.tmp",
    "data",
    // Vendored, pre-built browser code. `allowJs` is on, so without this TypeScript parses
    // all 3.5 MB of minified mermaid on every `astro check` — which crashes it outright.
    "web/vendor"
  ]
}
