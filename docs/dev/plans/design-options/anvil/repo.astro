---
import AnvilLayout from '../../../layouts/designs/AnvilLayout.astro';

const files = [
  { dir: true, name: '.claude', msg: 'Add agent instructions for local dev', age: 'last week', heat: 2 },
  { dir: true, name: '.github/workflows', msg: 'ci: run playwright on pull requests', age: '3 weeks ago', heat: 3 },
  { dir: true, name: 'docs', msg: 'docs: document zip export', age: '13 hours ago', heat: 1 },
  { dir: true, name: 'public', msg: 'Regenerate PWA icons', age: '2 months ago', heat: 4 },
  { dir: true, name: 'src', msg: 'Release 0.3.0', age: '2 hours ago', heat: 1 },
  { dir: true, name: 'tests/local', msg: 'Cover SQL playground export', age: 'yesterday', heat: 1 },
  { dir: true, name: 'tools', msg: 'tools: script to vendor sqlite wasm', age: '5 months ago', heat: 4 },
  { dir: false, name: '.gitattributes', msg: 'Mark wasm as binary', age: '1 year ago', heat: 5 },
  { dir: false, name: '.gitignore', msg: 'Ignore playwright report', age: '3 weeks ago', heat: 3 },
  { dir: false, name: 'CHANGELOG.md', msg: 'Release 0.3.0', age: '2 hours ago', heat: 1 },
  { dir: false, name: 'README.md', msg: 'readme: quickstart + screenshots', age: 'last week', heat: 2 },
  { dir: false, name: 'VERSION', msg: 'Release 0.3.0', age: '2 hours ago', heat: 1 },
  { dir: false, name: 'astro.config.mjs', msg: 'Enable view transitions', age: '4 months ago', heat: 4 },
  { dir: false, name: 'package.json', msg: 'Release 0.3.0', age: '2 hours ago', heat: 1 },
  { dir: false, name: 'playwright.config.ts', msg: 'Run tests against preview server', age: '2 years ago', heat: 6 },
];
const tabs = [
  { label: 'Code', count: '', current: true },
  { label: 'Commits', count: '81' },
  { label: 'Branches', count: '3' },
  { label: 'Tags', count: '12' },
  { label: 'Releases', count: '9' },
  { label: 'Insights', count: '' },
];
---
<AnvilLayout title="kieran / useful" active="repo">
  <header class="repo-head">
    <div class="crumb">
      <a href="/designs/anvil/">kieran</a>
      <span class="sep">/</span>
      <span>useful</span>
      <span class="vis">public</span>
    </div>
    <p class="desc">An offline-first, local-first app: timers, notes, generators and a SQL playground with no server.</p>
    <div class="badges">
      <span><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M3 5h10M3 5l-2 4h4l-2-4ZM13 5l-2 4h4l-2-4Z"/></svg>License <b>MIT</b></span>
      <span><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="4" cy="4" r="1.8"/><circle cx="4" cy="12" r="1.8"/><circle cx="12" cy="6" r="1.8"/><path d="M4 6v4M12 8c0 3-8 1-8 4"/></svg>Default <b>main</b></span>
      <span><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="4" cy="4" r="1.8"/><circle cx="4" cy="12" r="1.8"/><circle cx="12" cy="6" r="1.8"/><path d="M4 6v4M12 8c0 3-8 1-8 4"/></svg><b>3</b> branches</span>
      <span><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2h6l6 6-6 6-6-6V2Z"/><circle cx="5.5" cy="5.5" r="1"/></svg><b>12</b> tags</span>
      <span><svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6" cy="5" r="2.5"/><path d="M1.5 14c0-3 2-4.5 4.5-4.5s4.5 1.5 4.5 4.5M11 3.5a2.5 2.5 0 0 1 0 5M12.5 10c1.5.6 2 2 2 4"/></svg><b>2</b> contributors</span>
      <span data-heat="1"><span class="age">updated 2 hours ago</span></span>
    </div>
  </header>

  <nav class="tabs" aria-label="Repository sections">
    {tabs.map((t) => (
      <a href={t.current ? '/designs/anvil/repo' : '#'} aria-current={t.current ? 'page' : undefined}>
        {t.label}{t.count && <span class="tc">{t.count}</span>}
      </a>
    ))}
  </nav>

  <div class="repo-grid">
    <!-- ================= code column ================= -->
    <div>
      <div class="toolbar">
        <button class="btn" type="button" aria-haspopup="listbox">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="4" cy="4" r="1.8"/><circle cx="4" cy="12" r="1.8"/><circle cx="12" cy="6" r="1.8"/><path d="M4 6v4M12 8c0 3-8 1-8 4"/></svg>
          main <span class="muted">▾</span>
        </button>
        <span class="btn btn-ghost"><b>3</b>&nbsp;branches · <b>12</b>&nbsp;tags</span>
        <label class="gofile">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 4 4"/></svg>
          <input type="search" placeholder="Go to file" aria-label="Go to file" />
          <kbd>t</kbd>
        </label>
        <span class="tb-spacer"></span>
        <a class="btn" href="#">+ Add note</a>
        <div class="clone-wrap">
          <button class="btn btn-primary" type="button" aria-expanded="true">
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 4-3 4 3 4M11 4l3 4-3 4M9.5 2.5l-3 11"/></svg>
            Clone <span>▾</span>
          </button>
          <div class="clone-menu" role="dialog" aria-label="Clone options">
            <div class="cm-row">
              <span class="label">HTTPS</span>
              <div class="cm-url">
                <code>https://forge.kieranwood.ca/useful.git</code>
                <button type="button" aria-label="Copy clone URL" title="Copy">
                  <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9"/><path d="M3 11H2V2h9v1"/></svg>
                </button>
              </div>
            </div>
            <div class="cm-row" style="padding:0">
              <a class="cm-item" href="#">
                <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2 13h12"/></svg>
                Download ZIP <small>main · 1.8 MB</small>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="commit-bar" data-heat="1">
        <span class="who"><span class="mini-av" aria-hidden="true">KW</span>Kieran Wood</span>
        <a class="msg" href="#">Release 0.3.0</a>
        <span class="sep">·</span>
        <a class="sha" href="#">a1b9f2e</a>
        <span class="sep">·</span>
        <span class="age">2 hours ago</span>
        <span class="cb-right">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.2"/><path d="M1 8h4.8M10.2 8H15"/></svg>
          <a href="#"><b>81</b> commits</a>
        </span>
      </div>

      <table class="files" aria-label="Files in main">
        <tbody>
          {files.map((f) => (
            <tr class={f.dir ? 'dir' : 'file'} data-heat={f.heat}>
              <td class="f-ic" aria-hidden="true">
                {f.dir ? (
                  <svg class="icon" viewBox="0 0 16 16"><path d="M1.5 3.5h5l1.5 2h6.5v7h-13v-9Z"/></svg>
                ) : (
                  <svg class="icon" viewBox="0 0 16 16"><path d="M3.5 1.5h6l3 3v10h-9v-13Z"/><path d="M9.5 1.5v3h3"/></svg>
                )}
              </td>
              <td class="f-name"><a href="#">{f.name}</a></td>
              <td class="f-msg"><a href="#">{f.msg}</a></td>
              <td class="f-age"><span class="age">{f.age}</span></td>
            </tr>
          ))}
        </tbody>
      </table>

      <section class="panel repo-readme">
        <div class="panel-head">
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h5a2 2 0 0 1 2 2v9a2 2 0 0 0-2-2H2V3ZM14 3H9a2 2 0 0 0-2 2v9a2 2 0 0 1 2-2h5V3Z"/></svg>
          <b>README.md</b>
          <span class="ph-right">3.1 KB · <a href="#">view source</a></span>
        </div>
        <article class="readme">
          <h1>useful</h1>
          <p>A small box of tools that work entirely in your browser: timers, notes, text and data generators, and a SQL playground backed by SQLite compiled to WASM. There is no server and no account. Install it as a PWA and it keeps working on a plane.</p>
          <h2>What's in it</h2>
          <ul>
            <li><strong>Timers</strong> — countdowns, stopwatches and pomodoro, persisted locally.</li>
            <li><strong>Notes</strong> — markdown notes with full-text search, stored in IndexedDB.</li>
            <li><strong>Generators</strong> — UUIDs, lorem ipsum, passwords, fake records for fixtures.</li>
            <li><strong>SQL playground</strong> — load a CSV, query it with real SQLite, export the result.</li>
          </ul>
          <h2>Quickstart</h2>
          <pre><code><span class="sh-p">$ </span>npm install
<span class="sh-p">$ </span>npm run dev</code></pre>
          <p>Then open <code>http://localhost:4321</code>. Production builds are fully static: <code>npm run build</code> writes to <code>dist/</code>.</p>
        </article>
      </section>
    </div>

    <!-- ================= about panel ================= -->
    <aside class="about" aria-label="About this repository">
      <section>
        <span class="label">About</span>
        <p>An offline-first, local-first app: timers, notes, generators and a SQL playground with no server.</p>
