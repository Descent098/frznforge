import EmberLayout from '../../../layouts/designs/EmberLayout.astro';

// Deterministic contribution heat-map: 52 weeks x 7 days, column-major.
function hash(n: number): number {
  let x = (Math.imul(n + 1, 2654435761) >>> 0);
  x ^= x >>> 13;
  x = Math.imul(x, 0x5bd1e995) >>> 0;
  x ^= x >>> 15;
  return x >>> 0;
}
const cells = Array.from({ length: 52 * 7 }, (_, i) => {
  const week = Math.floor(i / 7);
  const day = i % 7;
  const h = hash(i);
  // recent weeks are busier; weekends quieter
  const recency = week / 51;
  const bias = (h % 100) / 100 + recency * 0.45 - (day === 0 || day === 6 ? 0.25 : 0);
  let level = 0;
  if (bias > 0.55) level = 1;
  if (bias > 0.8) level = 2;
  if (bias > 1.0) level = 3;
  if (bias > 1.18) level = 4;
  if ((h >> 8) % 7 === 0 && week < 40) level = 0; // gaps
  const temp = week >= 44 ? 'hot' : week >= 32 ? 'warm' : week >= 16 ? 'cool' : 'cold';
  return { level, temp };
});
const months = ['Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug'];

