                <Fragment set:html={p.template ? I.tmpl : I.repo} />
                {p.name}
                {p.template && <span class="chip template">Template</span>}
              </span>
              <p class="desc">{p.desc}</p>
              <div class="lang-bar" aria-hidden="true">
                {p.langs.map(([k, , pct]) => <span class={`sw-${k}`} style={`width:${pct}%`}></span>)}
              </div>
              <div class="meta">
                {p.langs.slice(0, 3).map(([k, label, pct]) => (
                  <span class="lang"><i class={`sw sw-${k}`}></i>{label}{p.langs.length > 1 ? ` ${pct}%` : ''}</span>
                ))}
                {p.tags.length > 0 && <span class="tags">{p.tags.map((t) => <span class="chip tag">{t}</span>)}</span>}
                <span class:list={['age', 'chip', `t-${p.temp}`]}><i class="t-dot"></i>{p.ago}</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- contribution graph -->
      <section class="panel contrib">
        <div class="contrib-top">
          <b>1,204 contributions</b><span>in the last year</span>
          <span class="temp-legend">older <i class="temp-ramp"></i> newer</span>
        </div>
        <div class="graph-wrap">
          <div class="graph-months">{months.map((m) => <span>{m}</span>)}</div>
          <div class="graph" role="img" aria-label="Contribution heat map, 52 weeks">
            {cells.map((c) => <i data-t={c.temp} data-l={c.level}></i>)}
          </div>
        </div>
        <div class="graph-foot">
          <span>Less</span>
          <span class="lv"><i style="background:var(--bg-3)"></i><i data-t="cold" data-l="2" style="background:rgba(60,110,165,.5)"></i><i style="background:var(--cool)"></i><i style="background:var(--warm)"></i><i style="background:var(--hot)"></i></span>
          <span>More</span>
          <span style="margin-left:auto">Intensity = commits · hue = recency</span>
        </div>
      </section>

      <!-- activity + languages -->
      <section>
        <h2 class="sec"><Fragment set:html={I.pulse} /> Recent activity <a class="more" href="#">Full log →</a></h2>
        <div class="panel">
          <ul class="events">
            {events.map((e) => (
              <li class={`t-${e.temp}`}>
                <span class="ev-ic" set:html={e.icon} />
                <span class="ev-txt" set:html={e.html} />
                <span class={`age t-${e.temp}`}><i class="t-dot"></i>{e.ago}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- command palette preview (static mockup) -->
      <section>
        <h2 class="sec"><Fragment set:html={I.key} /> Command palette <span class="more">Ctrl K · direction preview</span></h2>
        <div class="palette-preview">
          <span class="label">Static preview — not interactive</span>
          <div class="palette" aria-hidden="true">
            <div class="pal-in">
              <Fragment set:html={I.search} />
              <span class="q">use</span>
              <span class="scope">All</span>
              <kbd class="key">esc</kbd>
            </div>
            <div class="grp">
              <h4>Repositories</h4>
              <div class="item sel"><Fragment set:html={I.repo} /><span class="path"><b><mark>use</mark>ful</b> · offline-first toolbox</span><span class="age t-hot"><i class="t-dot"></i>2h</span></div>
              <div class="item"><Fragment set:html={I.repo} /><span class="path"><b><mark>use</mark>r-scripts</b> · misc automation</span><span class="age t-cold"><i class="t-dot"></i>2y</span></div>
            </div>
            <div class="grp">
              <h4>Files in useful</h4>
              <div class="item"><Fragment set:html={I.file} /><span class="path">src/lib/db/<b><mark>use</mark>Store.ts</b></span><span class="age t-hot"><i class="t-dot"></i>13h</span></div>
              <div class="item"><Fragment set:html={I.file} /><span class="path">docs/<b><mark>use</mark>r-guide.md</b></span><span class="age t-warm"><i class="t-dot"></i>3w</span></div>
            </div>
            <div class="grp">
              <h4>Actions</h4>
              <div class="item"><Fragment set:html={I.flame} /><span class="path"><b>Go to</b> recent commits</span><span class="k kbd-group"><kbd class="key">g</kbd><kbd class="key">c</kbd></span></div>
              <div class="item"><Fragment set:html={I.key} /><span class="path"><b>Toggle</b> theme</span><span class="k kbd-group"><kbd class="key">t</kbd></span></div>
            </div>
            <div class="pal-foot">
              <span><kbd class="key">↑</kbd><kbd class="key">↓</kbd> navigate</span>
              <span><kbd class="key">↵</kbd> open</span>
              <span><kbd class="key">Tab</kbd> scope</span>
              <span class="r">6 results · 0.8 ms</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</EmberLayout>
