---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · frznforge</title>
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ember-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="side" id="side">
        <a class="brand" href="/designs/ember/">
          <span class="brand-mark" set:html={I.flame} />
          frznforge
          <small>ember</small>
        </a>

        <div class="search" role="button" tabindex="0" aria-label="Search or jump to">
          <Fragment set:html={I.search} />
          <span>Search or jump to…</span>
          <span class="kbd-group"><kbd class="key">Ctrl</kbd><kbd class="key">K</kbd></span>
        </div>

        <nav class="nav-sec" aria-label="Primary">
          <div class="nav-h">Overview</div>
          <a class:list={['nav-a', { active: active === 'profile' }]} href="/designs/ember/"><Fragment set:html={I.person} /> Profile</a>
          <a class="nav-a" href="#"><Fragment set:html={I.repo} /> Repositories <span class="count">42</span></a>
          <a class="nav-a" href="#"><Fragment set:html={I.note} /> Notes <span class="count">9</span></a>
        </nav>

        {active === 'repo' && (
          <nav class="nav-sec" aria-label="Repository">
            <div class="nav-h">useful</div>
            <a class="nav-a active" href="/designs/ember/repo"><Fragment set:html={I.code} /> Code</a>
            <a class="nav-a" href="#"><Fragment set:html={I.commit} /> Commits <span class="count">81</span></a>
            <a class="nav-a" href="#"><Fragment set:html={I.branch} /> Branches <span class="count">3</span></a>
            <a class="nav-a" href="#"><Fragment set:html={I.tag} /> Tags <span class="count">12</span></a>
            <a class="nav-a" href="#"><Fragment set:html={I.release} /> Releases <span class="count">12</span></a>
            <a class="nav-a" href="#"><Fragment set:html={I.graph} /> Insights</a>
          </nav>
        )}

        <nav class="nav-sec" aria-label="Pinned">
          <div class="nav-h">Pinned</div>
          <a class="nav-a" href="/designs/ember/repo"><i class="dot bg-hot"></i> useful <span class="ago t-hot">2h</span></a>
          <a class="nav-a" href="#"><i class="dot bg-hot"></i> frznforge <span class="ago t-hot">1d</span></a>
          <a class="nav-a" href="#"><i class="dot bg-warm"></i> ezcv <span class="ago t-warm">3w</span></a>
          <a class="nav-a" href="#"><i class="dot bg-neutral"></i> sdu <span class="ago t-neutral">4mo</span></a>
          <a class="nav-a" href="#"><i class="dot bg-cold"></i> ahd <span class="ago t-cold">1y</span></a>
          <a class="nav-a" href="#"><i class="dot bg-cold"></i> kuws <span class="ago t-cold">2y</span></a>
        </nav>

        <div class="side-foot">
          <div class="row">
            <a class="tiny" href="/designs/">← All designs</a>
            <button class="theme-btn" type="button" id="theme-toggle" aria-label="Toggle colour theme">
              <Fragment set:html={I.sun} /><Fragment set:html={I.moon} /> Theme
            </button>
          </div>
          <div class="row"><span class="tiny">Built 2h ago · static</span></div>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <button class="btn btn-sm menu-btn" type="button" id="menu-toggle" aria-label="Toggle navigation"><Fragment set:html={I.menu} /></button>
          <slot name="crumbs" />
          <span class="spacer"></span>
          <a class="ghost" href="/designs/">← All designs</a>
        </header>
        <main class="content">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', function () {
          var root = document.documentElement;
          var cur = root.getAttribute('data-theme');
          if (!cur) cur = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          var next = cur === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('ember-theme', next); } catch (e) {}
        });
        var m = document.getElementById('menu-toggle'), s = document.getElementById('side');
        if (m && s) m.addEventListener('click', function () { s.classList.toggle('open'); });
      })();
    </script>
  </body>
</html>
