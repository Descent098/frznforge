<EmberLayout title="kieran/useful" active="repo">
  <div class="crumbs" slot="crumbs">
    <span class="avatar ava-xs">KW</span>
    <a href="/designs/ember/">kieran</a>
    <span class="sep">/</span>
    <a href="/designs/ember/repo"><strong>useful</strong></a>
  </div>

  <header class="repo-head">
    <div class="repo-title">
      <Fragment set:html={I.repo} />
      <a href="/designs/ember/">kieran</a>
      <span class="sep">/</span>
      <strong>useful</strong>
      <span class="chip">Public</span>
      <span class="age chip t-hot"><i class="t-dot"></i>active</span>
    </div>
    <p class="repo-desc">An offline-first, local-first app: timers, notes, generators and a SQL playground with no server.</p>
    <div class="badges">
      <a href="#"><Fragment set:html={I.law} /> <b>MIT</b> license</a>
      <span><Fragment set:html={I.branch} /> default <code>main</code></span>
